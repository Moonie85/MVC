@model Academy.Models.Teacher

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Teacher</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.full_name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.full_name)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.work_since)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.work_since)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.rate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.rate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Disciplines)
        </dt>
        <dd class="col-sm-10">
            @if (Model?.TDR != null && Model.TDR.Any())
            {
                <ul class="mb-0">
                    @foreach (var item in Model.TDR)
                    {
                        <li>@item.Discipline.discipline_name</li>
                    }
                </ul>
            }
            else
            {
                <span>Дисциплины не назначены</span>
            }
        </dd>

        @* 
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TDR)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TDR)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.last_name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.last_name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.first_name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.first_name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.middle_name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.middle_name)
        </dd> 
        *@

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.birth_date)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.birth_date)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.email)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.phone)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.phone)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.photo)
        </dt>
        <dd class="col-sm-10">
            @if (Model?.photo != null && Model.photo.Length > 0)
            {
                <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.photo)"
                     alt="Фото преподавателя"
                     style="max-width: 200px; border-radius: 8px;" />
            }
            else
            {
                <span>Фото отсутствует</span>
            }
        </dd>
    </dl> 
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.teacher_id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
